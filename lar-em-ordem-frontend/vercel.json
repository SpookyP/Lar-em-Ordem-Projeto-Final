{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://lar-em-ordem-projeto-final.onrender.com/api/:path*" },
    { "source": "/sanctum/:path*", "destination": "https://lar-em-ordem-projeto-final.onrender.com/sanctum/:path*" },
    { "source": "/auth/:path*", "destination": "https://lar-em-ordem-projeto-final.onrender.com/auth/:path*" },
    {
      "source": "/login",
      "has": [{ "type": "header", "key": "x-requested-with", "value": "XMLHttpRequest" }],
      "destination": "https://lar-em-ordem-projeto-final.onrender.com/login"
    },
    {
      "source": "/logout",
      "has": [{ "type": "header", "key": "x-requested-with", "value": "XMLHttpRequest" }],
      "destination": "https://lar-em-ordem-projeto-final.onrender.com/logout"
    },
    {
      "source": "/forgot-password",
      "has": [{ "type": "header", "key": "x-requested-with", "value": "XMLHttpRequest" }],
      "destination": "https://lar-em-ordem-projeto-final.onrender.com/forgot-password"
    },
    {
      "source": "/reset-password",
      "has": [{ "type": "header", "key": "x-requested-with", "value": "XMLHttpRequest" }],
      "destination": "https://lar-em-ordem-projeto-final.onrender.com/reset-password"
    },
    {
      "source": "/user/:path*",
      "has": [{ "type": "header", "key": "x-requested-with", "value": "XMLHttpRequest" }],
      "destination": "https://lar-em-ordem-projeto-final.onrender.com/user/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}