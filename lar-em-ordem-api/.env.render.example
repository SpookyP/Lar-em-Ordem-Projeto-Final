APP_NAME="Lar em Ordem"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# both are the Vercel address: the browser only talks to Vercel, which forwards to Render
APP_URL=https://YOUR-PROJECT.vercel.app
FRONTEND_URL=https://YOUR-PROJECT.vercel.app
SANCTUM_STATEFUL_DOMAINS=YOUR-PROJECT.vercel.app

# no SESSION_DOMAIN on purpose: the cookie belongs to the Vercel host
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

LOG_CHANNEL=stderr
LOG_LEVEL=warning
PRIVACY_POLICY_VERSION=2026-11

# TiDB Cloud > Connect
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=4000
DB_DATABASE=laremordem
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=r2
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=

# Brevo > SMTP & API > SMTP (port 2525: Render blocks 25, 465 and 587)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Lar em Ordem"

# Pusher > App Keys
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

PYTHON_PATH=python
BENCHMARK_MIN_SAMPLE=5